aws_region   = "us-east-1"
name_prefix  = "zomato"

# Your existing ECR repository (must already exist in this account/region)
# Provide either the repo name or the full repository URL.
ecr_repository_name = "zomato-app"
# ecr_repository_url  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/zomato-app"
ecr_image_tag        = "latest"

# Optional: build from GitHub and push to that ECR on apply
# app_github_repo       = "iamtejas23/zomato-clone"
# app_github_ref        = "main"
# build_and_push_image  = true

# Optional: HTTPS on ALB port 443 (ACM cert in same region as ALB)
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

container_port    = 3000
health_check_path = "/"
ecs_cpu           = 256
ecs_memory        = 512
ecs_desired_count = 2
# ECS on EC2 instance settings:
# ecs_instance_type                     = "t3.small"
# ecs_instance_desired_capacity         = 2
# ecs_instance_min_size                 = 1
# ecs_instance_max_size                 = 3
# ecs_on_demand_base_capacity           = 1
# ecs_on_demand_percentage_above_base_capacity = 50
# ecs_spot_allocation_strategy          = "capacity-optimized"

tags = {
  Environment = "dev"
}
