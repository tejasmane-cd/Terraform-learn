# GitHub Actions — fill these in later (Settings → Secrets and variables → Actions).
# This file is a template only. Do not put real credentials in a committed copy.
#
# After `terraform apply`, use outputs to populate GitHub:
#   terraform output github_actions_role_arn
#   terraform output -raw ecr_repository_name
#   terraform output -raw ecs_cluster_name
#   terraform output -raw ecs_service_name
#
# ------------------------------------------------------------------------------
# SECRET (Repository secrets — add one secret named exactly below)
# ------------------------------------------------------------------------------
#   Name:  AWS_ROLE_TO_ASSUME
#   Value: <full ARN from terraform output github_actions_role_arn>
AWS_ROLE_TO_ASSUME=

# ------------------------------------------------------------------------------
# VARIABLES (Repository variables — same names the workflow expects)
# ------------------------------------------------------------------------------
#   Name: AWS_REGION          Value: same as Terraform var.aws_region (e.g. us-east-1)
AWS_REGION=

#   Name: ECR_REPOSITORY      Value: terraform output -raw ecr_repository_name
ECR_REPOSITORY=

#   Name: ECS_CLUSTER_NAME    Value: terraform output -raw ecs_cluster_name
ECS_CLUSTER_NAME=

#   Name: ECS_SERVICE_NAME    Value: terraform output -raw ecs_service_name
ECS_SERVICE_NAME=
